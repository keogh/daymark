{
  "name": "daymark",
  "productName": "Daymark",
  "version": "0.1.0",
  "description": "A local-first desktop time tracker.",
  "author": "Isaac Zepeda",
  "type": "module",
  "main": ".vite/build/main.cjs",
  "private": true,
  "scripts": {
    "dev": "electron-forge start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:macos:arm64": "electron-forge make --platform=darwin --arch=arm64",
    "make:macos:x64": "electron-forge make --platform=darwin --arch=x64",
    "make:windows:x64": "electron-forge make --platform=win32 --arch=x64",
    "make:linux:x64": "electron-forge make --platform=linux --arch=x64",
    "icon:windows": "node --experimental-strip-types scripts/generate-windows-icon.ts",
    "inspect:macos:arm64": "node --experimental-strip-types scripts/inspect-macos-package.ts --arch arm64",
    "inspect:macos:x64": "node --experimental-strip-types scripts/inspect-macos-package.ts --arch x64",
    "inspect:windows:x64": "node --experimental-strip-types scripts/inspect-windows-package.ts",
    "inspect:linux:x64": "node --experimental-strip-types scripts/inspect-linux-deb.ts",
    "release:validate": "node --experimental-strip-types scripts/release-contract.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "electron-squirrel-startup": "1.0.1",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/asar": "3.4.1",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/electron-squirrel-startup": "1.0.2",
    "@types/node": "24.10.13",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "drizzle-kit": "0.31.10",
    "electron": "43.4.0",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "jsdom": "29.1.1",
    "png-to-ico": "3.0.1",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "24.18.1"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "better-sqlite3@13.0.3": true,
    "electron-winstaller@5.4.4": true,
    "fs-xattr@0.3.1": true,
    "fsevents@2.3.3": true,
    "macos-alias@0.2.12": true
  }
}
